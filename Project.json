{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Generalizable",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Generalizable": {
      "deploymentTarget": "26.0",
      "info": {
        "path": "ios/Generalizable/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Generalizable",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ],
          "RevenueCatAPIKey": "$(REVENUECAT_API_KEY)"
        }
      },
      "platform": "iOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.8dc46b5e-4822-4579-8164-5376ed092a21",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "SWIFT_STRICT_CONCURRENCY": "minimal",
        "MTL_LANGUAGE_REVISION": "Metal30",
        "REVENUECAT_API_KEY": "appl_REPLACE_WITH_PUBLIC_KEY"
      },
      "sources": [
        {
          "path": "ios/Generalizable",
          "excludes": [
            "Resources/Cases/**",
            "Generalizable.storekit"
          ]
        },
        {
          "path": "ios/Generalizable/Resources/Cases",
          "type": "folder",
          "buildPhase": "resources"
        }
      ],
      "type": "application",
      "dependencies": [
        {
          "package": "RevenueCat",
          "product": "RevenueCat"
        },
        {
          "package": "RevenueCat",
          "product": "RevenueCatUI"
        }
      ],
      "scheme": {
        "storeKitConfiguration": "ios/Generalizable/Generalizable.storekit"
      }
    }
  },
  "packages": {
    "RevenueCat": {
      "url": "https://github.com/RevenueCat/purchases-ios-spm",
      "from": "5.0.0"
    }
  }
}
